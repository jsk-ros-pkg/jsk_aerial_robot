<?xml version="1.0" encoding="utf-8"?>
<launch>
  <!-- simulation:=true : camera image (/usb_cam/image_raw) is published by gazebo, run tag detection only -->
  <arg name="simulation" default="false" />
  <arg name="video_device" default="/dev/video0" />
  <arg name="launch_prefix" default="" /> <!-- "gdbserver localhost:10000" for remote debugging -->
  <arg name="node_namespace" default="apriltag_ros_continuous_node" />
  <arg name="image_view" default="true" />

  <!-- USB camera (real machine only) -->
  <node unless="$(arg simulation)" name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen">
    <param name="video_device" value="$(arg video_device)" />
    <param name="image_width" value="1280" />
    <param name="image_height" value="720" />
    <param name="pixel_format" value="mjpeg" />
    <param name="framerate" value="30" />
    <param name="camera_frame_id" value="usb_cam" />
    <param name="camera_name" value="narrow_stereo" />
    <param name="io_method" value="mmap" />
    <param name="camera_info_url" value="file://$(find camera)/config/calibration_info.yaml" />
  </node>

  <!-- /usb_cam/image_raw -> /usb_cam/image_rect, image_rect_color -->
  <node unless="$(arg simulation)" name="image_proc" pkg="image_proc" type="image_proc" ns="usb_cam" output="screen" />

  <!-- AprilTag detection -->
  <node pkg="apriltag_ros" type="apriltag_ros_continuous_node" name="$(arg node_namespace)"
        clear_params="true" output="screen" launch-prefix="$(arg launch_prefix)">
    <!-- gazebo camera has no distortion, so image_raw can be used directly -->
    <remap from="image_rect" to="/usb_cam/image_rect" unless="$(arg simulation)" />
    <remap from="image_rect" to="/usb_cam/image_raw" if="$(arg simulation)" />
    <remap from="camera_info" to="/usb_cam/camera_info" />
    <param name="publish_tag_detections_image" type="bool" value="true" />
    <rosparam command="load" file="$(find apriltag_ros)/config/settings.yaml" />
    <rosparam command="load" file="$(find camera)/config/tags.yaml" />
  </node>

  <node if="$(arg image_view)" name="image_view" pkg="image_view" type="image_view" output="screen">
    <remap from="image" to="/tag_detections_image" />
    <param name="autosize" value="true" />
  </node>
</launch>
