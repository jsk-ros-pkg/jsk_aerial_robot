<?xml version="1.0"?>
<launch>
  <arg name="robot_ns" value="dragon"/>
  <arg name="headless" value="False"/>
  <arg name="rviz_config" value="$(find dragon)/config/rviz_config"/>

  <group ns="$(arg robot_ns)">

    ###########  Servo Config  ###########
    <rosparam file="$(find dragon)/config/quad/v1_5_202601/Servo.yaml" command="load" />

    ########## Robot description #########
    <param name="robot_description" command="$(find xacro)/xacro '$(find dragon)/robots/quad/v1_5_202601.urdf.xacro' robot_name:=$(arg robot_ns)" />

  </group>

  ########## Simulation in Mujoco #########
  <include file="$(find aerial_robot_simulation)/launch/mujoco.launch" >
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="headless" value="$(arg headless)"/>
    <arg name="mujoco_model" value="$(find dragon)/mujoco/quad/v1_5_202601/robot.xml"/>
    <arg name="use_spinal" value="False"/>
  </include>

  ###########  Servo Bridge  ###########
  <node pkg="aerial_robot_model" type="servo_bridge_node" name="servo_bridge"  output="screen" ns="$(arg robot_ns)"/>

  ########## Visualization #########
  <group ns="$(arg robot_ns)">
    <node name="$(anon robot_state_publisher)" pkg="robot_state_publisher" type="robot_state_publisher">
      <param name="tf_prefix" value="$(arg robot_ns)" />
    </node>
    <node name="$(anon rotor_tf_publisher)" pkg="aerial_robot_model" type="rotor_tf_publisher">
      <param name="tf_prefix" value="$(arg robot_ns)" />
    </node>
  </group>

  <group unless="$(arg headless)">
    <node name="$(anon rviz)" pkg="rviz" type="rviz" args="-d $(arg rviz_config)" respawn="true" unless="$(arg headless)"/>
  </group>

</launch>
