  <xacro:property name="arm_variant" value="$(arg arm_variant)"/>

  <xacro:if value="${arm_variant == '3DoF_arm'}">
    <xacro:arm_3dof parent_link="main_body"/>
  </xacro:if>
  <xacro:if value="${arm_variant == '5DoF_arm'}">
    <xacro:arm_5dof parent_link="main_body"/>
  </xacro:if>
  
</robot>
