<?xml version='1.0' encoding='UTF-8'?>
<robot name="gimbalrotor" xmlns:xacro="http://www.ros.org/wiki/xacro">  

  <xacro:arg name="arm_variant" default="no_arm"/>
  <xacro:include filename="$(find gimbalrotor)/urdf/grape/common.xacro"/>
  <xacro:include filename="$(find gimbalrotor)/urdf/grape/xacro/gimbal_inertial.xacro"/>
  <xacro:include filename="$(find gimbalrotor)/urdf/grape/arm_xacro/3DoF_arm.xacro"/>
  <xacro:include filename="$(find gimbalrotor)/urdf/grape/arm_xacro/5DoF_arm.xacro"/>

  <!-- <link name="root"> -->
  <!--   <inertial> -->
  <!--     <origin xyz="0 0 0" rpy="0 0 0"/> -->
  <!--     <mass value="0.00001"/> -->
  <!--     <inertia -->
  <!--         ixx="0.000001" ixy="0.0" ixz="0.0" -->
  <!--         iyy="0.000001" iyz="0.0" -->
  <!--         izz="0.000001"/> -->
  <!--   </inertial> -->
