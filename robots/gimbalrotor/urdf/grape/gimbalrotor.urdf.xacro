  <!-- </joint> -->
  <!-- <joint name="rotor_arm3_joint" type="fixed"> -->
  <!--   <parent link="main_body"/> -->
  <!--   <child link="rotor_arm3"/> -->
  <!--   <axis xyz="0 0 1"/> -->
  <!--   <origin xyz="0.22309 0.22309 0.0" rpy="0.0 -0.0 0.7854000000000001"/> -->
  <!-- </joint> -->
  <!-- <joint name="rotor_arm4_joint" type="fixed"> -->
  <!--   <parent link="main_body"/> -->
  <!--   <child link="rotor_arm4"/> -->
  <!--   <axis xyz="0 0 1"/> -->
  <!--   <origin xyz="-0.22309 0.22309 0.0" rpy="0.0 -0.0 2.3562"/> -->
  <!-- </joint> -->

  <joint name="gimbal1" type="revolute">
    <limit effort="1.5" velocity="6.39" lower="-3.14" upper="3.14"/>
    <parent link="main_body"/>
    <child link="gimbal1_link"/>
    <axis xyz="1. 0. 0."/>
    <origin xyz="-0.22309 -0.22309 0.0" rpy="0.0 -0.0 -2.3562"/>
  </joint>

  <joint name="rotor1" type="continuous">
    <limit effort="0.0" velocity="0.0" lower="0.0" upper="30.0"/>
    <parent link="gimbal1_link"/>
    <child link="thrust1"/>
    <axis xyz=" 0.  0. -1."/>
    <origin xyz="0.0 0.0 0.0585" rpy="0.0 -0.0 0.0"/>
  </joint>

  <joint name="gimbal2" type="revolute">
    <limit effort="1.5" velocity="6.39" lower="-3.14" upper="3.14"/>
    <parent link="main_body"/>
    <child link="gimbal2_link"/>
    <axis xyz="1. 0. 0."/>
    <origin xyz="0.22309 -0.22309 0.0" rpy="-0.0 -0.0 -0.7854000000000001"/>
  </joint>

  <joint name="rotor2" type="continuous">
    <limit effort="0.0" velocity="0.0" lower="0.0" upper="30.0"/>
    <parent link="gimbal2_link"/>
    <child link="thrust2"/>
    <axis xyz="0. 0. 1."/>
    <origin xyz="0.0 0.0 0.0585" rpy="0.0 -0.0 0.0"/>
  </joint>

  <joint name="gimbal3" type="revolute">
    <limit effort="1.5" velocity="6.39" lower="-3.14" upper="3.14"/>
    <parent link="main_body"/>
    <child link="gimbal3_link"/>
    <axis xyz="1. 0. 0."/>
    <origin xyz="0.22309 0.22309 0.0" rpy="0.0 -0.0 0.7854000000000001"/>
  </joint>

  <joint name="rotor3" type="continuous">
    <limit effort="0.0" velocity="0.0" lower="0.0" upper="30.0"/>
    <parent link="gimbal3_link"/>
    <child link="thrust3"/>
    <axis xyz=" 0.  0. -1."/>
    <origin xyz="0.0 0.0 0.0585" rpy="0.0 -0.0 0.0"/>
  </joint>

  <joint name="gimbal4" type="revolute">
    <limit effort="1.5" velocity="6.39" lower="-3.14" upper="3.14"/>
    <parent link="main_body"/>
    <child link="gimbal4_link"/>
    <axis xyz="1. 0. 0."/>
    <origin xyz="-0.22309 0.22309 0.0" rpy="0.0 -0.0 2.3562"/>
  </joint>

  <joint name="rotor4" type="continuous">
    <limit effort="0.0" velocity="0.0" lower="0.0" upper="30.0"/>
    <parent link="gimbal4_link"/>
    <child link="thrust4"/>
    <axis xyz="0. 0. 1."/>
    <origin xyz="0.0 0.0 0.0585" rpy="0.0 -0.0 0.0"/>
  </joint>

  <transmission name="gimbal1_tran">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="gimbal1">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="servo1">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="gimbal2_tran">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="gimbal2">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="servo2">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="gimbal3_tran">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="gimbal3">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="servo3">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="gimbal4_tran">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="gimbal4">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="servo4">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="rotor_tran1">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rotor1">
      <hardwareInterface>RotorInterface</hardwareInterface>
    </joint>
    <actuator name="rotor_actuator1">
      <hardwareInterface>RotorInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="rotor_tran2">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rotor2">
      <hardwareInterface>RotorInterface</hardwareInterface>
    </joint>
    <actuator name="rotor_actuator2">
      <hardwareInterface>RotorInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="rotor_tran3">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rotor3">
      <hardwareInterface>RotorInterface</hardwareInterface>
    </joint>
    <actuator name="rotor_actuator3">
      <hardwareInterface>RotorInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="rotor_tran4">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rotor4">
      <hardwareInterface>RotorInterface</hardwareInterface>
    </joint>
    <actuator name="rotor_actuator4">
      <hardwareInterface>RotorInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  
  <material name="__unnamed_material_1">
    <color rgba="0.10980392 0.10980392 0.10980392 1.        "/>
  </material>
  <material name="__unnamed_material_2">
    <color rgba="0.75294118 0.75294118 0.75294118 1.        "/>
  </material>
  <material name="__unnamed_material_3">
    <color rgba="0.50196078 0.50196078 0.50196078 1.        "/>
  </material>
  <material name="__unnamed_material_4">
    <color rgba="0.89803922 0.91764706 0.92941176 1.        "/>
  </material>
  <material name="__unnamed_material_5">
