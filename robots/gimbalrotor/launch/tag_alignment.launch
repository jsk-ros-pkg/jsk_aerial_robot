<?xml version="1.0"?>
<launch>
    <include file="$(find gimbalrotor)/launch/wall_bringup.launch">
        <arg name="rm" value="false" />
        <arg name="sim" value="true" />
        <arg name="airframe" value="beatle" />
        <arg name="worldname" value="wall_apriltag" />
        <arg name="headless" value="false" />
        <arg name="enable_camera" value="true" />
    </include>
    <!-- override baselink rotation interpolation of GimbalrotorNavigator (NavigationConfig.yaml: 0.2 s / 0.04 rad)
         to make the target attitude change smoother while keeping the max rate (0.2 rad/s) -->
    <group ns="gimbalrotor">
        <param name="navigation/baselink_rot_pub_interval" value="0.025" />
        <param name="navigation/baselink_rot_change_thresh" value="0.005" />
    </group>
    <include file="$(find camera)/launch/apriltag_detection.launch">
        <arg name="simulation" value="true" />
    </include>
    <node pkg="gimbalrotor" type="tag_alignment.py" name="tag_alignment_node" output="screen">
    </node>
</launch>