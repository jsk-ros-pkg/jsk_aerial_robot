# generated by the acados wrapper package

if [ -z "$CATKIN_ENV_HOOK_WORKSPACE" ]; then
  CATKIN_ENV_HOOK_WORKSPACE="@CMAKE_INSTALL_PREFIX@"
fi

export ACADOS_SOURCE_DIR="@ACADOS_EXTERNAL_SOURCE_DIR@"

_acados_prepend_unique() {
  _acados_var_name="$1"
  _acados_path="$2"

  if [ -z "$_acados_path" ] || [ ! -d "$_acados_path" ]; then
    return
  fi

  eval "_acados_current=\${$_acados_var_name:-}"
  case ":$_acados_current:" in
    *":$_acados_path:"*) ;;
    *)
      if [ -z "$_acados_current" ]; then
        eval "export $_acados_var_name=\"$_acados_path\""
      else
        eval "export $_acados_var_name=\"$_acados_path:\$_acados_current\""
      fi
      ;;
  esac
}

_acados_prepend_unique LD_LIBRARY_PATH "$CATKIN_ENV_HOOK_WORKSPACE/lib"
_acados_prepend_unique LD_LIBRARY_PATH "$ACADOS_SOURCE_DIR/lib"
_acados_prepend_unique PYTHONPATH "$ACADOS_SOURCE_DIR/interfaces/acados_template"
_acados_prepend_unique PATH "$ACADOS_SOURCE_DIR/bin"

unset -f _acados_prepend_unique
unset _acados_var_name
unset _acados_path
unset _acados_current
